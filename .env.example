# WordPress credentials (Blackbird Publishing)
# Generate an Application Password: WP Admin → Users → claude → Application Passwords
CLAUDE_BLACKBIRD_WP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Inkwren API keys — workspace-scoped (one key per workspace).
# Durable record only. The Inkwren MCP server reads its token from the literal
# value in ~/.claude.json (set via `claude mcp add-json`), NOT from this file —
# see the /mcp skill. All three workspaces are wired into MCP for Rookwood as
# separate server instances (inkwren = Blackbird, inkwren-borogrove, inkwren-jamie)
# so it can pull catalog data for any of Jamie's books/stories regardless of imprint.
INKWREN_AUTH_TOKEN_BLACKBIRD="ink_xxx"
INKWREN_AUTH_TOKEN_BOROGROVE="ink_xxx"
INKWREN_AUTH_TOKEN_JAMIE="ink_xxx"
