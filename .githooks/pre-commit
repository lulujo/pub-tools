#!/bin/sh
# Run an integration's tests when its engine or tests are staged.
# Bypass with `git commit --no-verify` if you ever need to.

staged=$(git diff --cached --name-only)

if echo "$staged" \
    | grep -qE 'integrations/wordpress/(md_to_gutenberg|test_md_to_gutenberg)\.py$'; then
    echo "pre-commit: running md_to_gutenberg tests…"
    if ! ( cd integrations/wordpress && python3 test_md_to_gutenberg.py ); then
        echo "pre-commit: tests FAILED — commit aborted (override with --no-verify)." >&2
        exit 1
    fi
fi

if echo "$staged" \
    | grep -qE 'integrations/storybundle/(storybundle|test_storybundle)\.py$'; then
    echo "pre-commit: running storybundle tests…"
    if ! ( cd integrations/storybundle && python3 test_storybundle.py ); then
        echo "pre-commit: tests FAILED — commit aborted (override with --no-verify)." >&2
        exit 1
    fi
fi
